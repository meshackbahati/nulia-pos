# ============================================
# BorderShop POS - Environment Configuration
# ============================================

# ============================================
# REQUIRED: Core Settings
# ============================================

# Database Connection (Neon PostgreSQL - FREE!)
# Sign up: https://neon.tech → Create Project → Copy Connection String
# Format: postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/database?sslmode=require
***REMOVED***="postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/bordershop?sslmode=require"

# Netlify DB (Automatically set in Netlify, but useful for local reference)
# NETLIFY_***REMOVED***="postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/bordershop?sslmode=require"


# JWT Authentication Secret
# Generate: openssl rand -base64 32
***REMOVED***="change-this-to-a-secure-random-string-minimum-32-characters"
JWT_EXPIRES_IN="7d"

# Encryption Key (for sensitive data in database)
# Generate: openssl rand -base64 32
***REMOVED***="change-this-to-another-secure-random-32-char-string"

# ============================================
# REQUIRED: Application URLs
# ============================================

# API Base URL (Netlify Functions endpoint)
NEXT_PUBLIC_API_URL="http://localhost:8888/.netlify/functions"

# Application URL (Frontend)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# OPTIONAL: Application Settings
# ============================================

# App Branding
NEXT_PUBLIC_APP_NAME="BorderShop POS"
NEXT_PUBLIC_COMPANY_NAME="Your Company Name"

# Default Currency (can be overridden per branch in UI)
DEFAULT_CURRENCY="USD"

# Environment Mode
NODE_ENV="development"
DEBUG_MODE="true"

# ============================================
# 🎨 UI-MANAGED SETTINGS (Do NOT add here!)
# ============================================
# The following are configured through the
# Admin/Manager Dashboard → Settings page:
#
# Payment Integration (per branch):
#   - M-Pesa Consumer Key
#   - M-Pesa Consumer Secret
#   - M-Pesa Passkey
#   - M-Pesa Shortcode
#   - M-Pesa Environment (sandbox/production)
#
# Email Integration (global or per branch):
#   - Brevo API Key
#   - Sender Email
#   - Sender Name
#
# Storage Integration (global or per branch):
#   - Cloudinary Cloud Name
#   - Cloudinary API Key
#   - Cloudinary API Secret
#   - Cloudinary Upload Preset
#
# General Settings (per branch):
#   - Tax Rate
#   - Receipt Footer Text
#   - Low Stock Threshold
#   - etc.
#
# ============================================
# 
# How to configure:
# 1. Start the application
# 2. Login as Admin or Manager
# 3. Navigate to: Dashboard → Settings
# 4. Select category: Payment / Email / Storage
# 5. Enter credentials and save
# 
# Benefits:
# ✅ Branch-specific configurations
# ✅ Encrypted storage in database
# ✅ No server restart needed
# ✅ Audit trail of changes
# ✅ Easy to update via UI
# 
# ============================================
