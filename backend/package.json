{
    "name": "bordershop-backend",
    "version": "1.0.0",
    "description": "Serverless backend for BorderShop POS using Netlify Functions",
    "main": "index.js",
    "scripts": {
        "dev": "netlify dev",
        "build": "tsc",
        "deploy": "netlify deploy --prod",
        "db:migrate": "sequelize-cli db:migrate",
        "db:migrate:undo": "sequelize-cli db:migrate:undo",
        "db:seed": "sequelize-cli db:seed:all",
        "test": "jest",
        "lint": "eslint . --ext .ts"
    },
    "dependencies": {
        "@netlify/functions": "^2.4.1",
        "axios": "^1.6.7",
        "bcryptjs": "^2.4.3",
        "cloudinary": "^2.9.0",
        "dotenv": "^16.4.1",
        "jsonwebtoken": "^9.0.2",
        "mysql2": "^3.9.1",
        "pg": "^8.18.0",
        "sequelize": "^6.37.1",
        "sib-api-v3-sdk": "^8.5.0",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.131",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^20",
        "@types/sequelize": "^4.28.20",
        "@types/uuid": "^9.0.8",
        "netlify-cli": "^17.11.1",
        "sequelize-cli": "^6.6.2",
        "typescript": "^5"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
