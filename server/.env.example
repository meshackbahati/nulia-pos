# BorderShop POS Backend (Next.js) — Environment Variables
# Copy to .env.local for local dev, or set in Vercel project settings.

# PostgreSQL connection string (required)
***REMOVED***=***REMOVED_DB_URL***user:password@host:5432/bordershop?sslmode=require

# JWT
***REMOVED***=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Brevo email (optional; falls back to DB settings)
***REMOVED***=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BorderShop POS

# Encryption key for decrypting stored secrets (Settings/Integrations)
***REMOVED***=default-key-for-development-only-32

# M-Pesa
MPESA_ENVIRONMENT=sandbox

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cron job auth secret (must match vercel.json crons)
CRON_SECRET=change-me

# Frontend URL for password reset links
FRONTEND_URL=https://your-app.vercel.app

# Emailing toggle
ENABLE_EMAILING=true

# Paystack (public key, optional)
PAYSTACK_PUBLIC_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# Monthly hosting invoice email recipient + fees (cron: /api/cron/hosting-invoice)
HOSTING_INVOICE_RECIPIENT=
HOSTING_FEE_AMOUNT=
HOSTING_FEE_DB=3.00
HOSTING_FEE_BACKEND=3.00
HOSTING_FEE_SOCKETS=2.00
HOSTING_FEE_STORAGE=1.50
HOSTING_FEE_EMAIL=1.00
HOSTING_FEE_SSL=2.05

# Default currency (fallback when no Setting row exists)
DEFAULT_CURRENCY=KES
DEFAULT_CURRENCY_SYMBOL=KSh

# M-Pesa defaults (fallback; overridden by DB settings)
DEFAULT_MPESA_CONSUMER_KEY=
DEFAULT_MPESA_CONSUMER_SECRET=
DEFAULT_MPESA_PASSKEY=
DEFAULT_MPESA_SHORTCODE=
MPESA_CALLBACK_BASE_URL=https://your-app.vercel.app

# Debug
DEBUG_MODE=false
