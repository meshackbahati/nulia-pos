{
  "name": "retailpro",
  "private": true,
  "version": "1.0.8-2",
  "description": "RetailPro POS System",
  "author": {
    "name": "Meshack bahati",
    "email": "bahatikylemeshack@gmail.com"
  },
  "homepage": "https://retailpro.com",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "cap:sync": "npm run build && npx cap sync && bash patch-java17.sh",
    "cap:open:android": "npm run build && npx cap open android"
  },
  "build": {
    "appId": "com.retailpro.pos",
    "productName": "RetailPro",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/logo.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/logo.png"
    },
    "linux": {
      "target": [
        "pacman"
      ],
      "icon": "public/logo.png",
      "category": "Office"
    },
    "pacman": {
      "artifactName": "retailpro-${version}-${arch}.pkg.tar.zst"
    }
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.1.3",
    "@capacitor-mlkit/barcode-scanning": "^8.0.1",
    "@capacitor/android": "^8.3.1",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@radix-ui/react-toast": "^1.2.15",
    "@zxing/library": "^0.21.3",
    "axios": "^1.13.4",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^1.41.3",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.2",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.563.0",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vite-plugin-pwa": "^1.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.1",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.0.0-alpha.27",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "wait-on": "^9.0.5",
    "workbox-build": "^7.4.0",
    "workbox-window": "^7.4.0"
  }
}
