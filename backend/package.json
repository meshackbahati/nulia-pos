{
    "name": "bordershop-backend",
    "version": "1.0.0",
    "description": "Standard Express backend for BorderShop POS",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "pm2:start": "pm2 start ecosystem.config.cjs --env production",
        "pm2:stop": "pm2 stop bordershop-backend",
        "pm2:restart": "pm2 restart bordershop-backend",
        "pm2:logs": "pm2 logs bordershop-backend",
        "pm2:status": "pm2 status",
        "db:migrate": "sequelize-cli --options-path .sequelizerc.cjs db:migrate && node scripts/run-sql-migrations.js",
        "db:migrate:undo": "sequelize-cli --options-path .sequelizerc.cjs db:migrate:undo",
        "db:seed": "sequelize-cli --options-path .sequelizerc.cjs db:seed:all",
        "seed:interactive:scratch": "node scripts/scratch-interactive-seeder.js",
        "seed:REPL": "node scripts/seed_REPL.js",
        "test": "jest",
        "lint": "eslint . --ext .js"
    },
    "dependencies": {
        "axios": "^1.6.7",
        "bcryptjs": "^2.4.3",
        "cloudinary": "^2.9.0",
        "cors": "^2.8.5",
        "csv-parse": "^6.1.0",
        "decimal.js": "^10.6.0",
        "dotenv": "^16.4.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.5.2",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^2.0.2",
        "node-cron": "^4.5.0",
        "nodemailer": "^8.0.0",
        "pdfkit": "^0.19.1",
        "pg": "^8.11.3",
        "pg-hstore": "^2.3.4",
        "sequelize": "^6.37.1",
        "sib-api-v3-sdk": "^8.5.0",
        "socket.io": "^4.8.3",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.3",
        "sequelize-cli": "^6.6.2"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
